# The image only needs package.json, pnpm-lock.yaml, minimax-proxy.ts,
# router-proxy.ts and lib/, all copied explicitly by the Dockerfile. Everything else
# stays out of the build context.

# Other proxy entry points and their shared local state
v1-proxy.mjs
v2-proxy.ts
free-features.ts
free_models.json
tsconfig.json
mise.toml

# Repo meta
.git/
.gitignore
README.md
LICENSE
docs/
.env
api-keys.json
*.log
oc-workspace/
.cortexkit/

# Not needed at runtime: the tests run on a machine, not in the image.
test/
tools/

# Not needed at runtime, and the NAS deployment ships a compose file instead
Dockerfile
.dockerignore
docker-compose.yml
