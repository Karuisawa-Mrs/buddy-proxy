# The Dockerfile copies these by name, so they must stay visible: package.json,
# pnpm-lock.yaml, pnpm-workspace.yaml, router-proxy.ts, config-cli.ts, lib/, and
# web/ (with its own package.json, pnpm-lock.yaml, pnpm-workspace.yaml).
# Everything else stays out of the build context.

tsconfig.json
mise.toml

# Repo meta
.git/
.gitignore
README.md
LICENSE
docs/
.env
api-keys.json
*.log
oc-workspace/
.cortexkit/

# The root dependencies are installed inside the image (pnpm install in the
# Dockerfile); a local node_modules would only bloat the context, and its
# native builds are for the host, not for alpine.
node_modules/

# Not needed at runtime: the tests run on a machine, not in the image.
test/
tools/

# The database, the credentials and the logs of a local run: never in an image.
data/
*.db
*.db-wal
*.db-shm
admin-token

# Tooling for the people and agents working on the repository.
.agents/
.pi/
helper/
*.patch
部署说明.md
HANDOVER.md
AGENTS.md

# Not needed at runtime, and the NAS deployment ships a compose file instead
Dockerfile
.dockerignore
docker-compose.yml

# The panel is built in its own stage; its sources never reach the runtime
# image, only the built files do. But the stage needs the sources, so they
# must not be ignored — web/node_modules and web/dist are rebuilt anyway.
web/node_modules/
web/dist/
web/src/routeTree.gen.ts
